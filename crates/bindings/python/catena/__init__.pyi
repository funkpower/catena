from typing import Any, Iterable, Mapping, Sequence

__version__: str

def chunk_markdown(
    markdown: str,
    *,
    target: int | None = ...,
    overlap: int | None = ...,
    min_tokens: int | None = ...,
    hard_max: int | None = ...,
) -> list[dict[str, Any]]: ...
def scrub(markdown: str, *, pages: bool = ...) -> str: ...
def count_tokens(text: str) -> int: ...
def parse_subtitles(
    content: str, *, keep_repeats: bool = ...
) -> list[dict[str, Any]]: ...
def pack_cues(
    cues: Iterable[Mapping[str, Any]],
    *,
    seconds: float | None = ...,
    max_tokens: int | None = ...,
) -> list[dict[str, Any]]: ...
def segment_cues(
    cues: Iterable[Mapping[str, Any]],
    *,
    duration: float | None = ...,
    embeddings: Sequence[Sequence[float]] | None = ...,
) -> list[dict[str, Any]]: ...
def cue_windows(cues: Iterable[Mapping[str, Any]]) -> list[str]: ...
def split_collection(markdown: str) -> list[dict[str, Any]]: ...
def fuse_hits(
    hits: Iterable[Mapping[str, Any]],
    *,
    k: float | None = ...,
    weights: Mapping[str, float] | None = ...,
    limit: int | None = ...,
) -> list[dict[str, Any]]: ...
def identify(name: str, data: bytes) -> dict[str, Any]: ...
def find_citations(text: str) -> list[dict[str, Any]]: ...
def looks_like_footnote_citations(text: str) -> bool: ...
def citation_prompt(references: Iterable[Mapping[str, Any]]) -> str | None: ...
def merge_citation_reply(
    references: Iterable[Mapping[str, Any]], reply: str
) -> list[dict[str, Any]]: ...
def parse_identifier(text: str) -> dict[str, Any] | None: ...
def series_of(
    title: str, author: str | None = ...
) -> dict[str, Any] | None: ...
